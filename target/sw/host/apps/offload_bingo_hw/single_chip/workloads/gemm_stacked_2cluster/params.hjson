//
// The stacked GEMM of gemm_stacked_1cluster on each of the two clusters.
// Array shape 0: shape 1 reads past the end of A in this stacked layout.
{
    num_clusters: 2
    array_shape: 0
    transposed_A: 0
    transposed_B: 0
    K1: 16
    N1: 1
    M1: 1
    N2: 1
    addNonZeroC: 0
    addZeroC: 1
    accumPrevC: 0
}
